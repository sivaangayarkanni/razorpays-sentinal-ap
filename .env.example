# Sentinel-AP environment — copy to .env and adjust

APP_ENV=development
DEBUG=true

# Database (docker-compose overrides host to postgres)
DATABASE_URL=postgresql+asyncpg://sentinel:sentinel@localhost:5432/sentinel_ap
DATABASE_URL_SYNC=postgresql://sentinel:sentinel@localhost:5432/sentinel_ap

REDIS_URL=redis://localhost:6379/0

# Auth — CHANGE IN PRODUCTION
JWT_SECRET=change-me-to-a-long-random-string-for-production
ADMIN_EMAIL=admin@sentinel-ap.local
# Leave both empty to use the baked-in bcrypt hash in app/seed.py.
# A strong ADMIN_PASSWORD or ADMIN_PASSWORD_HASH overrides that hash.
# Do not use weak defaults such as admin123.
ADMIN_PASSWORD=
ADMIN_PASSWORD_HASH=

# Razorpay test keys (leave empty to use mock; RAZORPAY_MOCK=false + keys => real test mode)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_MOCK=false
# Optional — if unset, webhook skips HMAC verify with a warning log
RAZORPAY_WEBHOOK_SECRET=

# Bank health
BANK_HEALTH_THRESHOLD=0.95
BANK_HEALTH_MOCK_SUCCESS_RATE=0.98

CORS_ORIGINS=http://localhost:3000,https://sentinel-ap.vercel.app

# If Postgres is unreachable, boot with a local SQLite file instead of crashing
ALLOW_SQLITE_FALLBACK=true

ENABLE_DEMO=false
ENABLE_DOCS=false
