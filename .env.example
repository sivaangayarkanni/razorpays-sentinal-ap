# Sentinel-AP environment — copy to .env and adjust

APP_ENV=development
DEBUG=true

# Database (docker-compose overrides host to postgres)
DATABASE_URL=postgresql+asyncpg://sentinel:sentinel@localhost:5432/sentinel_ap
DATABASE_URL_SYNC=postgresql://sentinel:sentinel@localhost:5432/sentinel_ap

REDIS_URL=redis://localhost:6379/0

# Auth — CHANGE IN PRODUCTION
JWT_SECRET=change-me-to-a-long-random-string-for-production
ADMIN_EMAIL=admin@sentinel-ap.local
ADMIN_PASSWORD=admin123

# Razorpay test keys (leave empty to use mock)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_MOCK=true

# Bank health
BANK_HEALTH_THRESHOLD=0.95
BANK_HEALTH_MOCK_SUCCESS_RATE=0.98

CORS_ORIGINS=http://localhost:3000,https://sentinel-ap.vercel.app
